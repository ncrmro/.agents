{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "The default per-reviewer issue cap is 5. When the caller explicitly sets X, copy this schema into the subagent call and set issues.maxItems to X.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewer",
    "summary",
    "issues"
  ],
  "properties": {
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "issues": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "confidence",
          "category",
          "title",
          "file",
          "line",
          "end_line",
          "evidence",
          "impact",
          "recommendation",
          "disposition",
          "requirement",
          "library"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "file": {
                  "type": "null"
                }
              },
              "required": [
                "file"
              ]
            },
            "then": {
              "properties": {
                "line": {
                  "type": "null"
                },
                "end_line": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "line": {
                  "type": "null"
                }
              },
              "required": [
                "line"
              ]
            },
            "then": {
              "properties": {
                "end_line": {
                  "type": "null"
                }
              }
            }
          }
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "confidence": {
            "type": "integer",
            "minimum": 80,
            "maximum": 100
          },
          "category": {
            "type": "string",
            "enum": [
              "correctness",
              "regression",
              "security",
              "performance",
              "maintainability",
              "simplification",
              "configuration_surface",
              "platform_scope",
              "requirements",
              "tests",
              "e2e_user_flow",
              "library_reuse",
              "prose",
              "convention"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "line": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "end_line": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "fix_in_pr",
              "separate_change",
              "follow_up"
            ]
          },
          "requirement": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "library": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
