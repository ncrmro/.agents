#!/usr/bin/env python3
"""Harness-agnostic fallback for the Chapters tool surface.

Input is one JSON object: {"entity":"chapter","action":"status","args":{...}}.
The script intentionally mirrors the native Pi tool enough for non-Pi harnesses.
"""

from __future__ import annotations

import datetime as dt
import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any
from urllib.parse import urlparse

TODAY = dt.date.today().isoformat()
HARNESSES = {"pi", "claude", "codex", "gemini", "copilot"}
INCLUDES = {"tasks", "links", "sessions", "graph"}
MAX_CANDIDATES = 8
MAX_DISCOVERY_MATCHES = 24
MAX_FILE_BYTES = 256_000
IGNORED_DIRS = {".git", "node_modules", "dist", "coverage", ".next", ".direnv"}


@dataclass
class Task:
    text: str
    done: bool = False
    done_date: str | None = None


@dataclass
class Link:
    kind: str
    label: str
    url: str
    title: str
    state: str


@dataclass
class Session:
    harness: str
    cwd: str
    last_active: str
    resume_command: str


@dataclass
class Chapter:
    name: str
    status: str
    opened: str
    closed: str | None = None
    milestone: str | None = None
    repos: list[str] = field(default_factory=list)
    tasks: list[Task] = field(default_factory=list)
    links: list[Link] = field(default_factory=list)
    sessions: list[Session] = field(default_factory=list)
    unparsed: list[str] = field(default_factory=list)


@dataclass
class Page:
    slug: str
    path: Path
    raw: str
    before: str
    region: str
    after: str
    repos: list[str]
    chapters: list[Chapter]
    warnings: list[str]


def vault_root() -> Path:
    return Path(os.environ.get("CHAPTERS_NOTES_DIR", "~/notes")).expanduser()


def repos_root() -> Path:
    return Path(os.environ.get("CHAPTERS_REPOS_ROOT", "~/repos")).expanduser()


def projects_dir() -> Path:
    return vault_root() / "wiki" / "projects"


def die(message: str) -> None:
    raise SystemExit(message)


def candidates(names: list[str]) -> str:
    if not names:
        return "none"
    shown = names[:MAX_CANDIDATES]
    rest = len(names) - len(shown)
    return ", ".join(shown) + (f", … (+{rest} more)" if rest else "")


def fuzzy_score(text: str, query: str) -> int | None:
    text_l = text.lower()
    query_l = query.lower().strip()
    if not query_l:
        return 0
    if text_l == query_l:
        return -10_000
    pos = -1
    score = 0
    for ch in query_l:
        found = text_l.find(ch, pos + 1)
        if found == -1:
            return None
        score += found - pos
        pos = found
    return score + len(text_l)


def filter_by(items: list[Any], query: str | None, label) -> list[Any]:
    if query is None or not query.strip():
        return items
    wanted = query.strip().lower()
    exact = [item for item in items if label(item).lower() == wanted]
    if exact:
        return exact
    scored: list[tuple[int, Any]] = []
    for item in items:
        score = fuzzy_score(label(item), query)
        if score is not None:
            scored.append((score, item))
    return [item for _, item in sorted(scored, key=lambda pair: (pair[0], label(pair[1])))]


def resolve_by(items: list[Any], query: str, label, what: str):
    matches = filter_by(items, query, label)
    if len(matches) == 1:
        return matches[0]
    if not matches:
        die(f'{what}: "{query}" matched nothing — has: {candidates([label(i) for i in items])}')
    die(f'{what}: "{query}" is ambiguous — matches: {candidates([label(i) for i in matches])}')


def project_slugs() -> list[str]:
    root = projects_dir()
    if not root.exists():
        return []
    return sorted(path.stem for path in root.glob("*.md"))


def split_page(raw: str) -> tuple[str, str, str]:
    lines = raw.split("\n")
    try:
        start = next(i for i, line in enumerate(lines) if line.rstrip() == "## Chapters")
    except StopIteration:
        return raw, "", ""
    end = len(lines)
    for i in range(start + 1, len(lines)):
        if re.match(r"^## ", lines[i] or ""):
            end = i
            break
    return "\n".join(lines[:start]), "\n".join(lines[start:end]), "\n".join(lines[end:])


def parse_repos(raw: str) -> list[str]:
    if not raw.startswith("---\n"):
        return []
    end = raw.find("\n---", 4)
    if end == -1:
        return []
    repos: list[str] = []
    in_repos = False
    for line in raw[4:end].split("\n"):
        if re.match(r"^repos:\s*$", line):
            in_repos = True
            continue
        if in_repos:
            item = re.match(r"^\s+-\s+(\S+)\s*$", line)
            if item:
                repos.append(item.group(1))
                continue
            in_repos = False
    return repos


def parse_meta(line: str, chapter: Chapter) -> bool:
    parts = line.split(" · ")
    if not parts:
        return False
    if parts[0].startswith("open · since "):
        chapter.status = "open"
        chapter.opened = parts[0].removeprefix("open · since ")
        rest = parts[1:]
    elif parts[0].startswith("closed · "):
        chapter.status = "closed"
        span = parts[0].removeprefix("closed · ")
        if " → " not in span:
            return False
        chapter.opened, chapter.closed = span.split(" → ", 1)
        rest = parts[1:]
    else:
        return False
    for part in rest:
        if part.startswith("milestone: "):
            chapter.milestone = part.removeprefix("milestone: ")
        elif part.startswith("repos: "):
            chapter.repos = [item.strip() for item in part.removeprefix("repos: ").split(",") if item.strip()]
        else:
            return False
    return True


def parse_chapters(region: str) -> tuple[list[Chapter], list[str]]:
    body = "\n".join(region.split("\n")[1:]) if region else ""
    chapters: list[Chapter] = []
    current: Chapter | None = None
    warnings: list[str] = []
    for line in body.split("\n"):
        if line == "":
            continue
        heading = re.match(r"^### (.+)$", line)
        if heading:
            current = Chapter(name=heading.group(1), status="open", opened=TODAY)
            chapters.append(current)
            continue
        if current is None:
            warnings.append(f"unparsed outside chapter: {line}")
            continue
        if parse_meta(line, current):
            continue
        task = re.match(r"^- \[( |x)\] (.*?)(?: ✅ (\d{4}-\d{2}-\d{2}))?$", line)
        if task:
            current.tasks.append(Task(task.group(2), task.group(1) == "x", task.group(3)))
            continue
        link = re.match(r"^- \[(Issue|PR|Milestone) ([^\]]+)\]\(([^)]+)\) — (.+) · (.+)$", line)
        if link:
            current.links.append(Link(link.group(1).lower(), link.group(2), link.group(3), link.group(4), link.group(5)))
            continue
        session = re.match(r"^- session: (pi|claude|codex|gemini|copilot) · `([^`]+)` · (\d{4}-\d{2}-\d{2}) · `([^`]+)`$", line)
        if session:
            current.sessions.append(Session(session.group(1), session.group(2), session.group(3), session.group(4)))
            continue
        current.unparsed.append(line)
        warnings.append(f'unparsed in "{current.name}": {line}')
    return chapters, warnings


def read_page(slug: str) -> Page:
    path = projects_dir() / f"{slug}.md"
    raw = path.read_text()
    before, region, after = split_page(raw)
    chapters, warnings = parse_chapters(region)
    return Page(slug, path, raw, before, region, after, parse_repos(raw), chapters, warnings)


def emit_chapter(chapter: Chapter) -> list[str]:
    lines = [f"### {chapter.name}", ""]
    if chapter.status == "closed":
        meta = f"closed · {chapter.opened} → {chapter.closed or TODAY}"
    else:
        meta = f"open · since {chapter.opened}"
    if chapter.milestone:
        meta += f" · milestone: {chapter.milestone}"
    if chapter.repos:
        meta += f" · repos: {', '.join(chapter.repos)}"
    lines.append(meta)
    lines.append("")
    for task in [t for t in chapter.tasks if not t.done]:
        lines.append(f"- [ ] {task.text}")
    for task in [t for t in chapter.tasks if t.done]:
        lines.append(f"- [x] {task.text} ✅ {task.done_date or TODAY}")
    for link in chapter.links:
        kind = {"issue": "Issue", "pr": "PR", "milestone": "Milestone"}.get(link.kind, link.kind)
        lines.append(f"- [{kind} {link.label}]({link.url}) — {link.title} · {link.state}")
    for session in chapter.sessions:
        lines.append(f"- session: {session.harness} · `{session.cwd}` · {session.last_active} · `{session.resume_command}`")
    lines.extend(chapter.unparsed)
    return lines


def emit_region(chapters: list[Chapter]) -> str:
    ordered = [c for c in chapters if c.status == "open"] + [c for c in chapters if c.status != "open"]
    lines = ["## Chapters", ""]
    for i, chapter in enumerate(ordered):
        if i:
            lines.append("")
        lines.extend(emit_chapter(chapter))
    return "\n".join(lines)


def splice(page: Page, chapters: list[Chapter]) -> str:
    region = emit_region(chapters)
    if page.region:
        return page.before + "\n" + region + ("\n" + page.after if page.after else "")
    sep = "" if page.before.endswith("\n") else "\n"
    return page.before + sep + "\n" + region + "\n"


def write_page_locked(page: Page, mutate) -> str:
    lock_path = page.path.with_suffix(page.path.suffix + ".lock")
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        fresh = read_page(page.slug)
        summary = mutate(fresh.chapters)
        rendered = splice(fresh, fresh.chapters)
        fd, tmp_name = tempfile.mkstemp(prefix=f".{page.path.name}.", dir=str(page.path.parent))
        try:
            with os.fdopen(fd, "w") as tmp:
                tmp.write(rendered)
            os.replace(tmp_name, page.path)
        finally:
            if os.path.exists(tmp_name):
                os.unlink(tmp_name)
        return summary


def resolve_project(query: str) -> str:
    return resolve_by(project_slugs(), query, lambda s: s, "project")


def resolve_chapter(chapters: list[Chapter], query: str, project: str) -> Chapter:
    return resolve_by(chapters, query, lambda c: c.name, f'chapter in "{project}"')


def page_for_project_arg(args: dict[str, Any]) -> Page:
    project = string_arg(args, "project")
    return read_page(resolve_project(project))


def render_status(args: dict[str, Any]) -> str:
    all_slugs = project_slugs()
    project = optional_string(args, "project")
    slugs = filter_by(all_slugs, project, lambda s: s)
    if not slugs:
        return f'no project matching "{project}" — projects: {", ".join(all_slugs) or "none"}'
    status = args.get("status", "open")
    if status not in {"open", "closed", "all"}:
        die('args.status must be "open", "closed", or "all"')
    include = args.get("include", ["tasks", "links", "sessions"])
    if not isinstance(include, list) or any(item not in INCLUDES for item in include):
        die(f"args.include must contain only: {', '.join(sorted(INCLUDES))}")
    chapter_q = optional_string(args, "chapter")
    out: list[str] = []
    for slug in slugs:
        page = read_page(slug)
        chapters = filter_by(page.chapters, chapter_q, lambda c: c.name)
        chapters = [c for c in chapters if status == "all" or c.status == status]
        if not chapters:
            continue
        out.append(f"{page.slug} ({', '.join(page.repos)})")
        for chapter in chapters:
            meta = f"{chapter.status} since {chapter.opened}" if chapter.status == "open" else f"closed {chapter.opened} → {chapter.closed}"
            extra = f" · milestone {chapter.milestone}" if chapter.milestone else ""
            out.append(f"  {chapter.name} ({meta}{extra})")
            if "tasks" in include:
                for task in chapter.tasks:
                    mark = "x" if task.done else " "
                    done = f" ✅ {task.done_date}" if task.done and task.done_date else ""
                    out.append(f"    [{mark}] {task.text}{done}")
            if "links" in include:
                for link in chapter.links:
                    out.append(f"    {link.label} — {link.title} · {link.state} ({link.url})")
            if "sessions" in include:
                for session in chapter.sessions:
                    out.append(f"    {session.harness} · {session.cwd} · resume: {session.resume_command}")
    return "\n".join(out) if out else "no matching chapters"


def repo_path(owner_repo: str) -> Path:
    return repos_root() / owner_repo


def local_candidate_repos(project_slug: str) -> list[str]:
    owner_dir = repos_root() / project_slug
    if not owner_dir.exists():
        return []
    return sorted(f"{project_slug}/{p.name}" for p in owner_dir.iterdir() if p.is_dir())


def project_discover(args: dict[str, Any]) -> str:
    page = page_for_project_arg(args)
    candidates_local = local_candidate_repos(page.slug)
    registered = set(page.repos)
    missing = [repo for repo in candidates_local if repo not in registered]
    lines = [f"{page.slug} project discovery", "", "Registered repos:"]
    lines.extend(f"- {repo}{'' if repo_path(repo).exists() else ' (not found locally)'}" for repo in page.repos)
    if not page.repos:
        lines.append("- none")
    lines.extend(["", "Local candidate repos not registered:"])
    lines.extend(f"- {repo}" for repo in missing)
    if not missing:
        lines.append("- none")
    return "\n".join(lines)


def walk_files(root: Path):
    stack = [root]
    while stack:
        current = stack.pop()
        try:
            entries = list(current.iterdir())
        except OSError:
            continue
        for entry in entries:
            if entry.name in IGNORED_DIRS:
                continue
            try:
                stat = entry.stat()
            except OSError:
                continue
            if entry.is_dir():
                stack.append(entry)
            elif entry.is_file() and stat.st_size <= MAX_FILE_BYTES:
                yield entry


def search_repo(owner_repo: str, query: str) -> list[tuple[str, int, str]]:
    root = repo_path(owner_repo)
    if not root.exists():
        return []
    needle = query.lower()
    matches: list[tuple[str, int, str]] = []
    for path in walk_files(root):
        if len(matches) >= MAX_DISCOVERY_MATCHES:
            break
        try:
            lines = path.read_text(errors="ignore").splitlines()
        except OSError:
            continue
        for index, line in enumerate(lines, start=1):
            if needle in line.lower():
                matches.append((str(path.relative_to(root)), index, line.strip()[:180]))
                if len(matches) >= MAX_DISCOVERY_MATCHES:
                    break
    return matches


def chapter_discover(args: dict[str, Any]) -> str:
    page = page_for_project_arg(args)
    chapter = optional_string(args, "chapter") or optional_string(args, "query")
    if not chapter:
        die("args.chapter or args.query is required for chapter discovery")
    repos = sorted(set(page.repos + local_candidate_repos(page.slug)))
    all_matches: list[tuple[str, str, int, str]] = []
    for repo in repos:
        for rel, line, text in search_repo(repo, chapter):
            all_matches.append((repo, rel, line, text))
    matched_repos = sorted({repo for repo, _, _, _ in all_matches})
    missing_registered = [repo for repo in local_candidate_repos(page.slug) if repo not in page.repos]
    lines = [f"{page.slug} › {chapter} discovery", "", "Likely repo scope:"]
    lines.extend(f"- {repo}" for repo in matched_repos)
    if not matched_repos:
        lines.append("- no local matches found")
    lines.extend(["", "Matching files:"])
    lines.extend(f"- {repo}/{rel}:{line} — {text}" for repo, rel, line, text in all_matches)
    if not all_matches:
        lines.append("- none")
    if missing_registered:
        lines.extend(["", "Local candidate repos not registered on the project page:"])
        lines.extend(f"- {repo}" for repo in missing_registered)
    lines.extend(["", "Suggested intake questions:", f"1. What outcome closes the {chapter} chapter?", "2. Which matched repos are actually in scope?", "3. What first tasks, issues, PRs, or sessions should be recorded?", "4. Is this a real work arc or only an empty placeholder?", "", "No vault write was made by discovery."])
    return "\n".join(lines)


def string_arg(args: dict[str, Any], name: str) -> str:
    value = args.get(name)
    if not isinstance(value, str) or not value.strip():
        die(f"args.{name} must be a non-empty string")
    return value


def optional_string(args: dict[str, Any], name: str) -> str | None:
    value = args.get(name)
    if value is None:
        return None
    if not isinstance(value, str):
        die(f"args.{name} must be a string")
    return value


def string_array(args: dict[str, Any], name: str) -> list[str] | None:
    value = args.get(name)
    if value is None:
        return None
    if not isinstance(value, list) or any(not isinstance(item, str) for item in value):
        die(f"args.{name} must be an array of strings")
    return value


def open_chapter(args: dict[str, Any]) -> str:
    project = string_arg(args, "project")
    chapter_name = string_arg(args, "chapter")
    mode = args.get("mode", "intake")
    confirm = args.get("confirm", False)
    if mode != "placeholder" and not confirm:
        return chapter_discover({"project": project, "chapter": chapter_name}) + '\n\nchapter.open defaults to intake mode and did not write. Re-run with args.confirm=true after choosing scope/tasks, or args.mode="placeholder" for an explicit empty placeholder.'
    page = read_page(resolve_project(project))
    milestone = optional_string(args, "milestone")
    repos = string_array(args, "repos") or []

    def mutate(chapters: list[Chapter]) -> str:
        if any(c.name == chapter_name for c in chapters):
            die(f'chapter "{chapter_name}" already exists')
        chapters.append(Chapter(chapter_name, "open", TODAY, milestone=milestone, repos=repos))
        return f'opened chapter "{chapter_name}"'

    return write_page_locked(page, mutate)


def update_chapter(args: dict[str, Any], fn) -> str:
    project_query = string_arg(args, "project")
    slug = resolve_project(project_query)
    page = read_page(slug)
    chapter_query = string_arg(args, "chapter")

    def mutate(chapters: list[Chapter]) -> str:
        chapter = resolve_chapter(chapters, chapter_query, slug)
        notes = []
        if slug != project_query:
            notes.append(f'resolved project "{project_query}" → "{slug}"')
        if chapter.name != chapter_query:
            notes.append(f'resolved chapter "{chapter_query}" → "{chapter.name}"')
        summary = fn(chapter)
        return "\n".join([summary] + notes)

    return write_page_locked(page, mutate)


def close_chapter(args: dict[str, Any]) -> str:
    def fn(chapter: Chapter) -> str:
        chapter.status = "closed"
        chapter.closed = TODAY
        return f'closed chapter "{chapter.name}"'
    return update_chapter(args, fn)


def task_add(args: dict[str, Any]) -> str:
    text = string_arg(args, "task")
    def fn(chapter: Chapter) -> str:
        chapter.tasks.append(Task(text))
        return f'added task "{text}"'
    return update_chapter(args, fn)


def task_check(args: dict[str, Any]) -> str:
    text = string_arg(args, "task")
    def fn(chapter: Chapter) -> str:
        open_tasks = [task for task in chapter.tasks if not task.done]
        matches = [task for task in open_tasks if task.text == text or task.text.startswith(text)]
        if len(matches) != 1:
            reason = "matches nothing" if not matches else "is ambiguous"
            die(f'task "{text}" {reason} — open tasks: {candidates([t.text for t in open_tasks])}')
        matches[0].done = True
        matches[0].done_date = TODAY
        return f'checked task "{matches[0].text}"'
    return update_chapter(args, fn)


def link_from_url(url: str) -> Link:
    parsed = urlparse(url)
    parts = parsed.path.strip("/").split("/")
    if len(parts) < 4 or parts[2] not in {"issues", "pull"}:
        die(f"unrecognized GitHub issue/PR URL: {url}")
    repo = parts[1]
    number = parts[3]
    kind = "pr" if parts[2] == "pull" else "issue"
    label = f"{repo}#{number}"
    title = label
    state = "unknown"
    gh_kind = "pr" if kind == "pr" else "issue"
    try:
        proc = subprocess.run(["gh", gh_kind, "view", url, "--json", "title,state"], text=True, capture_output=True, check=True, timeout=20)
        data = json.loads(proc.stdout)
        title = data.get("title") or title
        state = str(data.get("state") or state).lower()
    except Exception:
        pass
    return Link(kind, label, url, title, state)


def link_add(args: dict[str, Any]) -> str:
    link = link_from_url(string_arg(args, "url"))
    def fn(chapter: Chapter) -> str:
        chapter.links = [existing for existing in chapter.links if existing.url != link.url]
        chapter.links.append(link)
        return f"linked {link.label} ({link.state})"
    return update_chapter(args, fn)


def session_attach(args: dict[str, Any]) -> str:
    harness = string_arg(args, "harness")
    if harness not in HARNESSES:
        die(f"args.harness must be one of: {', '.join(sorted(HARNESSES))}")
    session_id = string_arg(args, "id")
    cwd = string_arg(args, "cwd")
    if harness == "pi":
        resume = f"cd {cwd} && pi --resume {session_id}"
    elif harness == "claude":
        resume = f"cd {cwd} && claude --resume {session_id}"
    else:
        resume = f"cd {cwd} && {harness} # resume session {session_id} (adapter is a stub)"
    def fn(chapter: Chapter) -> str:
        session = Session(harness, cwd, TODAY, resume)
        chapter.sessions = [existing for existing in chapter.sessions if existing.resume_command != resume]
        chapter.sessions.append(session)
        return f"attached {harness} session in {cwd}"
    return update_chapter(args, fn)


def dispatch(payload: dict[str, Any]) -> str:
    entity = payload.get("entity")
    action = payload.get("action")
    args = payload.get("args") or {}
    if not isinstance(entity, str) or not isinstance(action, str) or not isinstance(args, dict):
        die('input must be {"entity": string, "action": string, "args": object}')
    if entity in {"project", "chapter"} and action == "status":
        return render_status(args)
    if entity == "project" and action == "discover":
        return project_discover(args)
    if entity == "chapter" and action == "discover":
        return chapter_discover(args)
    if entity == "chapter" and action == "open":
        return open_chapter(args)
    if entity == "chapter" and action == "close":
        return close_chapter(args)
    if entity == "task" and action == "add":
        return task_add(args)
    if entity == "task" and action == "check":
        return task_check(args)
    if entity == "link" and action == "add":
        return link_add(args)
    if entity == "session" and action == "attach":
        return session_attach(args)
    die(f"unsupported chapters action: {entity}.{action}")


def main() -> None:
    if len(sys.argv) != 2 or sys.argv[1] in {"-h", "--help"}:
        print("usage: chapters '<json {entity, action, args}>'", file=sys.stderr)
        raise SystemExit(2 if len(sys.argv) != 2 else 0)
    payload = json.loads(sys.argv[1])
    text = dispatch(payload)
    if os.environ.get("CHAPTERS_OUTPUT") == "json":
        print(json.dumps({"content": [{"type": "text", "text": text}], "details": {}}, indent=2))
    else:
        print(text)


if __name__ == "__main__":
    main()
